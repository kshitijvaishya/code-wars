# ============================================================
# Code Wars — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/codewars

# --- JWT ---
JWT_SECRET=change_me_to_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_to_another_long_random_secret_64_chars
JWT_REFRESH_EXPIRES_IN=7d

# --- Judge0 ---
# Use https://ce.judge0.com for dev or point to self-hosted instance
JUDGE0_BASE_URL=https://ce.judge0.com
JUDGE0_API_KEY=

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# --- Battle ---
DEFAULT_BATTLE_DURATION_SECONDS=1800
MATCHMAKING_TIMEOUT_SECONDS=60
DISCONNECT_GRACE_SECONDS=30

# --- Admin seed ---
ADMIN_EMAIL=admin@codewars.local
ADMIN_PASSWORD=change_me_admin_password
ADMIN_USERNAME=admin
