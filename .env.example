# ============================================================
# Code Wars — Serverless Environment Variables
# Copy to .env.local for development
# Set in Vercel Dashboard for production
# NEVER commit actual .env to source control
# ============================================================

# --- Database ---
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/codewars?retryWrites=true&w=majority

# --- JWT Authentication ---
JWT_SECRET=generate-64-char-random-string-here
JWT_REFRESH_SECRET=generate-another-64-char-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Ably Real-time (get from ably.com) ---
ABLY_API_KEY=your-ably-api-key

# --- Piston Code Execution ---
# Use public instance or point to self-hosted
PISTON_BASE_URL=https://emkc.org/api/v2/piston
PISTON_API_KEY=

# --- Application ---
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# --- Optional: Vercel Cron Authentication ---
CRON_SECRET=random-secret-for-cron-endpoints

# --- Optional: Redis Cache (Upstash or Vercel KV) ---
# REDIS_URL=redis://...

# ============================================================
# Generate secrets with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================================
