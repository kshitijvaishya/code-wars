{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "target": "ES2020",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@code-wars/shared": ["./shared/src/index.ts"]
    }
  },
  "include": [
    "vite.config.ts",
    "dev-api.ts",
    "api/**/*",
    "lib/**/*",
    "shared/**/*"
  ]
}
